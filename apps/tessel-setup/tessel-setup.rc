#pragma code_page(65001)
// 安装程序图标：和应用一样
1 ICON "../../assets/brand/tessel.ico"

1 VERSIONINFO
FILEVERSION 0,2,2,0
PRODUCTVERSION 0,2,2,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Tessel contributors"
            VALUE "FileDescription", "Tessel 拼贴 安装程序"
            VALUE "ProductName", "Tessel 拼贴"
            VALUE "FileVersion", "0.2.2"
            VALUE "ProductVersion", "0.2.2"
            VALUE "OriginalFilename", "Tessel-Setup.exe"
            VALUE "LegalCopyright", "MIT OR Apache-2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
